<?xml version="1.0"?>
<ruleset name="TubeSite">
    <description>PSR-12 + WordPress Coding Standards for the Tube Site monorepo (PHP 8.3 only). See ARCHITECTURE.md §11.</description>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <file>wp-content/plugins</file>
    <file>wp-content/themes/tube-theme</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!--
        WordPress-core-bundled default plugins/themes (see .gitignore):
        not part of this project, and not committed, but the wordpress:
        php8.3-fpm container re-copies them onto disk on every boot since
        they're bind-mounted — exclude them from linting the same way
        they're excluded from git.
    -->
    <exclude-pattern>*/wp-content/plugins/akismet/*</exclude-pattern>
    <exclude-pattern>*/wp-content/plugins/hello.php</exclude-pattern>
    <exclude-pattern>*/wp-content/plugins/index.php</exclude-pattern>
    <exclude-pattern>*/wp-content/themes/twentytwenty*/*</exclude-pattern>
    <exclude-pattern>*/wp-content/themes/index.php</exclude-pattern>

    <config name="testVersion" value="8.3-"/>
    <config name="minimum_supported_wp_version" value="6.5"/>

    <!-- Formatting: PSR-12 governs layout (indentation, braces, line length, use-statement ordering). -->
    <rule ref="PSR12"/>

    <!-- WordPress-specific security/i18n/query conventions. -->
    <rule ref="WordPress-Extra">
        <!--
            This project uses Composer PSR-4 autoloading with StudlyCaps
            namespaced classes (ARCHITECTURE.md §11) instead of WPCS's
            legacy `class-name-like-this.php` file-naming convention.
        -->
        <exclude name="WordPress.Files.FileName"/>

        <!--
            Empirically confirmed conflicts between WordPress-Extra's
            traditional layout conventions and PSR-12 (verified by running
            phpcs against the Phase 0 stub files, not assumed up front):
            WordPress wants tab indentation and padded control-structure
            parentheses; PSR-12 wants space indentation and unpadded ones.
            Per ARCHITECTURE.md §11, PSR-12 governs layout/formatting, so
            these specific WordPress layout sniffs are excluded in favor of
            the PSR-12 rule already active above. Every other WordPress-Extra
            sniff (escaping, i18n, DB query conventions, naming) is unaffected.
        -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceAfterOpenParenthesis"/>
        <exclude name="WordPress.WhiteSpace.ControlStructureSpacing.NoSpaceBeforeCloseParenthesis"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.SpaceAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.SpaceBeforeCloseBracket"/>

        <!--
            Empirically confirmed (Phase 1, first real classes): WordPress-
            Extra pulls in K&R brace placement for classes/functions
            (opening brace on the same line as the declaration), which
            directly contradicts PSR-12 4.1/4.5, requiring Allman style
            (brace on its own line) for classes and methods specifically
            — PSR-12 uses K&R only for control structures, which is
            already unaffected by this exclusion. Per §11, PSR-12 governs
            layout, so these two WordPress sniffs are excluded.
        -->
        <exclude name="Generic.Classes.OpeningBraceSameLine"/>
        <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>

        <!--
            WordPress.WhiteSpace.OperatorSpacing is fully redundant with
            PSR12.Operators.OperatorSpacing for general binary-operator
            checks (confirmed empirically: both fire identically on
            `$a=1;`), and is the specific source of an unresolvable
            conflict on `if (!defined(...))` (WordPress wants a space
            after "!", PSR-12 forbids a space after the opening
            parenthesis it's adjacent to). PSR-12's sniff covers the same
            ground without that conflict, so the WordPress one is excluded.
        -->
        <exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
    </rule>
    <rule ref="WordPress-Docs"/>

    <!-- Each tube-* plugin has its own prefix; enforce all of them project-wide. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="tube_core"/>
                <element value="TUBE_CORE"/>
                <element value="Tube_Core"/>
                <element value="tube_player"/>
                <element value="TUBE_PLAYER"/>
                <element value="Tube_Player"/>
                <element value="tube_search"/>
                <element value="TUBE_SEARCH"/>
                <element value="Tube_Search"/>
                <element value="tube_seo"/>
                <element value="TUBE_SEO"/>
                <element value="Tube_Seo"/>
                <element value="tube_admin"/>
                <element value="TUBE_ADMIN"/>
                <element value="Tube_Admin"/>
                <element value="tube_cache"/>
                <element value="TUBE_CACHE"/>
                <element value="Tube_Cache"/>
                <element value="tube_theme"/>
                <element value="TUBE_THEME"/>
                <element value="Tube_Theme"/>
            </property>
        </properties>
    </rule>

    <!--
        Custom tables (wp_tube_*) require direct $wpdb queries — a
        documented, intentional exception per ARCHITECTURE.md §2/§7.
        Enforced via inline `phpcs:ignore WordPress.DB.DirectDatabaseQuery`
        comments at each call site (from Phase 1 onward) rather than a
        blanket exclusion here, so every direct query still has to justify
        itself in code review.
    -->

    <!--
        Empirically confirmed (Phase 1, first real methods/classes with
        parameters): several sniffs transitively pulled in by PSR12/
        WordPress-Extra's dependency chain (PHPCSExtra's "Universal"
        collection, Squiz, PEAR) enforce a padded, legacy style that
        contradicts both PSR-12's own tighter conventions and this
        project's PHP-8.3-only, short-array-syntax-throughout style:
        padding inside array brackets and function-declaration
        parentheses, and long-form `array()` instead of `[]`. Per
        ARCHITECTURE.md §11, PSR-12 governs layout; these are excluded in
        favor of the tighter, unpadded style already used everywhere else
        in this codebase (e.g. Phase 0's `if (!defined('ABSPATH'))`).
    -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="NormalizedArrays.Arrays.ArrayBraceSpacing">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.WhiteSpace.ArbitraryParenthesesSpacing">
        <severity>0</severity>
    </rule>

    <!--
        Deliberate project decision, not a formatting nit: PSR-1 (via the
        PSR12 ruleset) mandates camelCase method names. This codebase is a
        WordPress plugin suite whose methods constantly wrap and sit
        alongside WordPress's own snake_case API
        (register_post_type(), add_action(), register_taxonomy(), ...) —
        camelCase methods calling into snake_case WP functions on every
        other line would be a worse readability/consistency outcome than
        the PSR-1 rule is meant to protect against. snake_case method
        names are used consistently throughout this project instead.
    -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <severity>0</severity>
    </rule>
</ruleset>
