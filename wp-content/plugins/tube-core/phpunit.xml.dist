<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <!--
        Unit suite only for now: pure-logic tests with no WordPress or
        database dependency (see tests/Unit). A WP-integration suite
        (real CPT/taxonomy registration, real migrations against a live
        DB) is intentionally not set up in Phase 1 — see PHASE-1.md for
        why, and end-to-end verification against the live staging
        environment for how that gap is covered instead.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">includes</directory>
            <directory suffix=".php">migrations</directory>
        </include>
    </source>
</phpunit>
