{
    "name": "phimtoico/tube-player",
    "description": "Tube Player: playback rendering and image management. Depends on tube-core at runtime only, not at the Composer level.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Tube_Player\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tube_Player\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    }
}
