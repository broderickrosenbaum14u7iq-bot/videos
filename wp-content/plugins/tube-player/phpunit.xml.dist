<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <!--
        Unit suite only, same split as every other plugin in this
        project: pure-logic tests with no WordPress dependency (see
        tests/Unit). The two HTML renderers and template-tags.php are
        WordPress-coupled (esc_url()/esc_attr()/Tube_Core\Plugin) and are
        verified via tests/Integration and live checks instead — see
        PHASE-6.md.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">includes</directory>
        </include>
    </source>
</phpunit>
