<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <!--
        Unit suite only, same posture as tube-core's own phpunit.xml.dist:
        pure-logic tests (or tests against a handful of stubbed WordPress
        functions — see tests/bootstrap.php) with no live database and no
        full WordPress bootstrap. Classes that call wp_insert_user(),
        wp_authenticate(), or wp_set_auth_cookie() are exercised instead
        via live, real-browser + real-database end-to-end verification
        (registration, login, wp-admin blocking, Google OAuth scaffolding,
        avatar upload). RedisRateLimiter (2026-08-28, P0 CRIT-2 fix) is
        the one Redis-touching class that DOES have Unit coverage —
        against a fake Predis\ClientInterface (tests/Unit/Support/
        Fixtures/) and the stubbed get_transient()/set_transient()/
        delete_transient() trio in tests/bootstrap.php, exercising both
        the healthy-Redis path and the fail-closed transient fallback
        deterministically, with no real Redis connection needed.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">includes</directory>
        </include>
    </source>
</phpunit>
