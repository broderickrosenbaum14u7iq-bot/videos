{
    "name": "phimtoico/tube-members",
    "description": "Tube Members: frontend registration/login, member profile, avatar, Google OAuth architecture. Depends on tube-core at runtime only, not at the Composer level.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "predis/predis": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Tube_Members\\": "includes/",
            "Tube_Members\\SchemaMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tube_Members\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    }
}
