{
    "name": "phimtoico/tube-admin",
    "description": "Tube Admin: operational wp-admin UI (import dashboard, statistics, actor/studio management, settings).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "Tube_Admin\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tube_Admin\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    }
}
