<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <!--
        Unit suite only, same split as tube-core/tube-cache/tube-player:
        pure-logic tests with no WordPress or live-database dependency
        (see tests/Unit). SearchIndexRepository and TubeCacheAdapter (the
        real $wpdb/Redis-backed adapters) are verified by the integration
        suite and live staging instead.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">includes</directory>
        </include>
    </source>
</phpunit>
