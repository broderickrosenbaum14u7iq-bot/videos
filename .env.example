# Copy this file to .env before running `docker compose up`.
# .env is gitignored — never commit real credentials, even staging ones.

MYSQL_DATABASE=tube_staging
MYSQL_USER=tube_staging
MYSQL_PASSWORD=change-me-staging
MYSQL_ROOT_PASSWORD=change-me-root

WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=tube_staging
WORDPRESS_DB_USER=tube_staging
WORDPRESS_DB_PASSWORD=change-me-staging

# tube-cache's Redis connection (ARCHITECTURE.md §12 Phase 3) — the
# `redis` service name, resolvable from every container on this compose
# network. No auth in staging (redis:7-alpine's default, no requirepass
# set) — production Redis auth is an ops/deploy concern, not something
# this staging config models.
REDIS_HOST=redis
REDIS_PORT=6379

# Shared secret for verifying Cloudflare Stream webhook signatures
# (ARCHITECTURE.md §12 Phase 5). Generate a real random value for any
# environment that actually registers a webhook with Cloudflare; the
# webhook is fail-closed if this is left empty (every request rejected).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=change-me-staging-webhook-secret

# tube-player's Cloudflare Stream/Images configuration (ARCHITECTURE.md
# §12 Phase 6). CUSTOMER_CODE is required for any player/thumbnail URL to
# resolve at all. SIGNING_KEY_ID/SIGNING_KEY_PEM_BASE64 are optional —
# leave both empty for unsigned mode (this project's default); set both
# to enable signed URLs. SIGNING_KEY_PEM_BASE64 is the Stream signing
# key's RSA private key, PEM-encoded then base64-encoded onto one line
# (`base64 < signing-key.pem`) — never commit a real one.
# IMAGES_ACCOUNT_HASH is only needed for the custom-poster-override path
# (no upload UI exists before tube-admin's Phase 10); leave empty until then.
CLOUDFLARE_STREAM_CUSTOMER_CODE=change-me-staging-customer-code
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM_BASE64=
CLOUDFLARE_STREAM_SIGNED_URL_TTL_SECONDS=3600
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# Host port nginx is published on, e.g. http://localhost:8080
HTTP_PORT=8080
