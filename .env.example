# Copy this file to .env before running `docker compose up`.
# .env is gitignored — never commit real credentials, even staging ones.

MYSQL_DATABASE=tube_staging
MYSQL_USER=tube_staging
MYSQL_PASSWORD=change-me-staging
MYSQL_ROOT_PASSWORD=change-me-root

WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=tube_staging
WORDPRESS_DB_USER=tube_staging
WORDPRESS_DB_PASSWORD=change-me-staging

# tube-cache's Redis connection (ARCHITECTURE.md §12 Phase 3) — the
# `redis` service name, resolvable from every container on this compose
# network. No auth in staging (redis:7-alpine's default, no requirepass
# set) — production Redis auth is an ops/deploy concern, not something
# this staging config models.
REDIS_HOST=redis
REDIS_PORT=6379

# Shared secret for verifying Cloudflare Stream webhook signatures
# (ARCHITECTURE.md §12 Phase 5). Generate a real random value for any
# environment that actually registers a webhook with Cloudflare; the
# webhook is fail-closed if this is left empty (every request rejected).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=change-me-staging-webhook-secret

# tube-core's Cloudflare Stream *API read* credentials (added alongside
# ADR-0001's follow-up fix) — distinct from CUSTOMER_CODE below, which is
# delivery-URL-only and cannot authenticate an API read. ACCOUNT_ID is the
# Cloudflare account ID; API_TOKEN needs Stream:Read permission. Used to
# pull a manually-entered Stream UID's real status/duration immediately
# (no webhook ever fires for a UID not uploaded through this project's
# own import pipeline). Leave both empty to leave this sync path
# unconfigured (fails closed, never corrupts existing data).
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Public R2/direct-MP4 base URL — the second video source alongside
# Cloudflare Stream. TUBE_CORE_R2_MEDIA_BASE_URL reads this; no R2 API
# credentials are needed here, since playback only ever uses this public
# custom domain, never the R2 S3 API. Leave empty to leave R2 support
# unconfigured (every R2 URL/key submitted in wp-admin is then rejected
# by R2MediaUrlNormalizer, since nothing can match an empty configured host).
CLOUDFLARE_R2_MEDIA_BASE_URL=

# Shared HMAC secret for signing temporary R2 playback URLs
# (Tube_Core\Video\R2\R2PlaybackUrlSigner). The Cloudflare Worker in
# infrastructure/cloudflare/r2-media-worker/ must be configured with the
# identical value as its own `R2_SIGNING_SECRET` Worker secret, or every
# signed URL this generates will fail verification there. Generate with
# e.g. `openssl rand -hex 32`. Leave empty to fail closed: signed URLs
# then degrade to the bare, unsigned public URL (see
# R2PlaybackUrlSigner::sign_url()'s own docblock) — never commit the real
# production value.
CLOUDFLARE_R2_SIGNING_SECRET=

# tube-player's Cloudflare Stream/Images configuration (ARCHITECTURE.md
# §12 Phase 6). CUSTOMER_CODE is required for any player/thumbnail URL to
# resolve at all. SIGNING_KEY_ID/SIGNING_KEY_PEM_BASE64 are optional —
# leave both empty for unsigned mode (this project's default); set both
# to enable signed URLs. SIGNING_KEY_PEM_BASE64 is the Stream signing
# key's RSA private key, PEM-encoded then base64-encoded onto one line
# (`base64 < signing-key.pem`) — never commit a real one.
# IMAGES_ACCOUNT_HASH is only needed for the custom-poster-override path
# (rendering delivery URLs — tube-player).
CLOUDFLARE_STREAM_CUSTOMER_CODE=change-me-staging-customer-code
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM_BASE64=
CLOUDFLARE_STREAM_SIGNED_URL_TTL_SECONDS=3600
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# Host port nginx is published on, e.g. http://localhost:8080
HTTP_PORT=8080
